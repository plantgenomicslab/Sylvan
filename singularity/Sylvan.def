BootStrap: docker
From: nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

%setup
	ROOTFS="${SINGULARITY_ROOTFS:-$APPTAINER_ROOTFS}"
	mkdir -p "$ROOTFS/root/.ssh"

%runscript
	echo "Container is managed externally by snakemake...use bin/Annotate.sh or bin/Filter.sh to run."

%post
	# Set the frontend of Debian-based systems like Ubuntu to be non-interactive to avoid manual inputs during package installation
	export DEBIAN_FRONTEND=noninteractive


	# Update the package index to get the latest versions and dependencies
	apt update -qq

	# Install multiple software packages and their specific versions, including compilers, development libraries, and utilities
	apt install -y \
		make \
		g++ \
		libbz2-dev \
		liblzma-dev \
		libparallel-forkmanager-perl \
		genometools \
		wget \
		vim \
		unzip \
		zlib1g \
		zlib1g-dev \
		curl \
		python3-dev \
		python3-pip \
		git \
		libhdf5-dev \
		build-essential

	# Remove unnecessary packages and dependencies that were automatically installed but are no longer needed
	apt-get autoremove


	# ---- Install and Configure Micromamba ---- #

	# Clear any host conda/mamba env vars leaked into %post by Apptainer
	unset CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_EXE CONDA_SHLVL
	unset MAMBA_ROOT_PREFIX MAMBA_EXE
	unset _CE_CONDA _CE_M
	rm -f /root/.condarc /root/.mambarc

	# Download and install micromamba (2.x works with explicit -r flag)
	curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/2.0.5 | tar -xvj -C /usr/local bin/micromamba

	# Dedicated root prefix (separate from env install paths to avoid conflicts)
	export MAMBA_ROOT_PREFIX=/opt/mamba
	mkdir -p /opt/mamba /opt/envs


	# ---- Create Conda Environments from inline YAML ---- #

	mkdir -p /tmp/envs

	cat > /tmp/envs/base.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - python>=3.10
  - pandas
  - scikit-learn
  - python-duckdb
  - matplotlib
  - tqdm
  - pyyaml
YAMLEOF

	cat > /tmp/envs/alignment.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  # Pinned: the 20260810 rebuild floated star down to 2.7.10b, which does not
  # know --quantTranscriptomeSAMoutput (2.7.11a+). Every filter STAR_paired job
  # died on it until Snakefile_filter went back to --quantTranscriptomeBan.
  # Change this pin and the flag in bin/Snakefile_filter together, never alone.
  - star=2.7.10b
  # Pinned to the version every existing stringtie.star.gff in the fleet was
  # built with (07-16..07-25, all 24 runs). The same 20260810 rebuild that moved
  # star also floated stringtie 3.0.3 -> 2.1.7. Nothing has re-run the rule since
  # -- the outputs exist and --rerun-triggers mtime will not rebuild them -- and
  # the flags the rule passes (-o -l -p -t -c -f) exist in both, so 2.1.7 would
  # not crash: it would quietly assemble different transcripts. NOTE the shipped
  # Sylvan_20260810_spaln.sif contains 2.1.7, so this pin only takes effect on
  # the next rebuild; until then do not force a stringtie_STAR rerun.
  - stringtie=3.0.3
  - hisat2
  - samtools
  - sambamba
  - fastp
  - minimap2
  - stringtie
  - gffcompare
  - mosdepth
  - bedtools
YAMLEOF

	cat > /tmp/envs/genepred.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - augustus
  - blast
  - diamond
  - miniprot
  - wise2
  - mmseqs2
  - liftoff
  - transdecoder
  - perl-uri
  - psiclass
  - seqkit
  - pblat
  - ucsc-blat
YAMLEOF

	cat > /tmp/envs/repeat.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - bedtools
  - h5py
  - hmmer
  - rmblast
  - trf
  - perl
  - perl-text-soundex
  - perl-uri
  - perl-lwp-simple
  - perl-file-which
  - perl-json
  - cd-hit
  - recon
  - repeatscout
  - ltr_retriever
  - genometools-genometools
  - mafft
  - ninja-nj
YAMLEOF

	cat > /tmp/envs/annotation.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - pasa
  - gmap
  - agat
  - gffread
  - evidencemodeler
  - evigene
  - spades
  - sqlite
  - perl-parallel-forkmanager
  - perl-db_file
  - perl-dbd-sqlite
YAMLEOF

	cat > /tmp/envs/filter.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - pfam_scan
  - hmmer
  - busco
  - rsem
YAMLEOF

	cat > /tmp/envs/helixer.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - python=3.10
  - h5py
  - pip:
    - tensorflow==2.15.0
    - nvidia-cuda-runtime-cu12
    - nvidia-cudnn-cu12
    - nvidia-cublas-cu12
    - nvidia-cufft-cu12
    - nvidia-cusolver-cu12
    - nvidia-cusparse-cu12
YAMLEOF

	cat > /tmp/envs/omark.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - omark
  - omamer
YAMLEOF

	cat > /tmp/envs/lncdc.yaml << 'YAMLEOF'
channels:
  - conda-forge
  - bioconda
dependencies:
  - python=3.9
  - biopython
  - imbalanced-learn=0.10.1
  - numpy
  - pandas
  - scikit-learn=1.1.3
  - tqdm
  - viennarna
  - xgboost=1.7.1
YAMLEOF

	echo "Verifying env YAML files in /tmp/envs/:"
	ls -la /tmp/envs/

	for env in base alignment genepred repeat annotation filter helixer omark lncdc; do
		if [ ! -f /tmp/envs/${env}.yaml ]; then
			echo "ERROR: /tmp/envs/${env}.yaml not found!"
			exit 1
		fi
		echo "Creating environment: $env"
		env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin MAMBA_ROOT_PREFIX=/opt/mamba \
			/usr/local/bin/micromamba create -y \
			-r /opt/mamba \
			-p /opt/envs/$env \
			-f /tmp/envs/${env}.yaml \
			-c conda-forge -c bioconda
	done

	# Install Helixer from GitHub (not on PyPI; HelixerPost binary is built separately below)
	env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin MAMBA_ROOT_PREFIX=/opt/mamba \
		/usr/local/bin/micromamba run -r /opt/mamba -p /opt/envs/helixer \
		pip install git+https://github.com/weberlab-hhu/Helixer.git

	# Create symlinks so micromamba can find envs by name (for `micromamba activate {name}`)
	mkdir -p /opt/mamba/envs
	for env in base alignment genepred repeat annotation filter helixer omark lncdc; do
		ln -s /opt/envs/$env /opt/mamba/envs/$env
	done


	# ---- ProtHint bundle (spaln + spaln_boundary_scorer) for genewise->spaln swap (2026-08-10 Ath_ODB pilot) ---- #
	# Prebuilt binaries are committed in the repo, so the source tag tarball is sufficient.
	cd /opt
	(curl -sL -o ProtHint.tar.gz https://github.com/gatech-genemark/ProtHint/archive/refs/tags/v2.6.0.tar.gz \
	 && tar xzf ProtHint.tar.gz && rm ProtHint.tar.gz && mv ProtHint-* ProtHint) \
	 || git clone --depth 1 https://github.com/gatech-genemark/ProtHint.git /opt/ProtHint
	chmod +x /opt/ProtHint/dependencies/spaln /opt/ProtHint/dependencies/spaln_boundary_scorer
	/opt/ProtHint/dependencies/spaln 2>&1 | head -3 || true
	/opt/ProtHint/dependencies/spaln_boundary_scorer 2>&1 | head -3 || true

	# ---- Install PsiCLASS ---- #
	# Change to the directory where source code is commonly stored
	cd /usr/local/src

	# Clone the PsiCLASS repository from GitHub
	git clone https://github.com/splicebox/PsiCLASS.git

	# Navigate into the PsiCLASS directory
	cd PsiCLASS

	# Fix unbounded chromosome-group scan in trust-splice (Sylvan-EGAPx #41):
	# the loop at GetTrustedSplice.cpp:213 has no `j < siteCnt` guard and walks
	# off the end of the sites vector on single-chromosome bins (all chrId == 0
	# matches zero-initialized heap) -> deterministic segfault. Cost the 2026
	# fleet 0.2-0.3% of the PsiClass track in Mtr/Ptr. Reported upstream.
	sed -i 's/for ( j = i + 1 ; sites\[j\].chrId == sites\[i\].chrId ; ++j )/for ( j = i + 1 ; j < siteCnt \&\& sites[j].chrId == sites[i].chrId ; ++j )/' GetTrustedSplice.cpp
	grep -q 'j < siteCnt && sites\[j\].chrId' GetTrustedSplice.cpp

	# Build PsiCLASS using the make command with 2 threads, which utilizes the Makefile present in the directory
	make


	# ---- Install Helixer Models ---- #

	mkdir -p /usr/local/src/Helixer/models
	wget -O /usr/local/src/Helixer/models/land_plant.h5 \
		https://zenodo.org/records/10836346/files/land_plant_v0.3_a_0080.h5?download=1
	wget -O /usr/local/src/Helixer/models/fungi.h5 \
		https://raw.githubusercontent.com/wyim-pgl/genome_annotation_installations/main/Helixer_models/fungi_v0.3_a_0400.h5
	wget -O /usr/local/src/Helixer/models/vertebrate.h5 \
		https://raw.githubusercontent.com/wyim-pgl/genome_annotation_installations/main/Helixer_models/vertebrate_v0.3_a_0400.h5


	# ---- OMAmer database (LUCA.h5) for OMArk ---- #
	# NOT bundled in container (~6 GB, would exceed Sylabs Cloud 10 GB limit).
	# Users download separately:  wget -O LUCA.h5 https://omabrowser.org/All/LUCA.h5
	# Then set Benchmark.omark_db in config_filter.yml to the host path.


	# ---- Install HelixerPost (Rust binary) ---- #

	# Navigate to the home directory of the current user
	cd

	# Download the Rust installation script from the official website quietly, saving it as 'rustup.sh'
	wget --retry-connrefused \
		--waitretry=1 \
		--read-timeout=20 \
		--timeout=15 \
		--tries=0 \
		--continue \
		 -q \
		https://sh.rustup.rs \
		-O rustup.sh

	# Change the permissions of the downloaded 'rustup.sh' script to make it executable
	chmod 775 rustup.sh

	# Execute the 'rustup.sh' script with the '-y' option to proceed without asking for confirmation
	./rustup.sh -y

	# Remove the 'rustup.sh' script as it is no longer needed after installation
	rm rustup.sh

	# Add the Cargo binary path to the system's PATH environment variable
	export PATH="/root/.cargo/bin:${PATH}"

	# Navigate to /usr/local/src directory
	cd /usr/local/src

	# Clone the HelixerPost repository from GitHub
	git clone https://github.com/plantgenomicslab/HelixerPost.git

	# Navigate into HelixerPost directory and checkout the specified commit
	cd HelixerPost && \
		git checkout d180ad8b353fa8da69342bdb924ecfaeea9464af

	# Navigate into the helixer_post_bin directory and build the release version using cargo
	cd helixer_post_bin && cargo build --release

	# Move the built binary to /usr/local/bin for global access
	mv /usr/local/src/HelixerPost/target/release/helixer_post_bin /usr/local/bin

	# Remove unnecessary build files and Rust toolchain (~1.5 GB)
	rm -rf /usr/local/src/HelixerPost/target/release/
	rm -rf /root/.rustup /root/.cargo /root/.cache


	# ---- Install GETA ---- #

	# Navigate to the /usr/local/bin directory where executables are commonly stored
	cd /usr/local/bin

	# Clone the GETA repository from GitHub
	git clone https://github.com/plantgenomicslab/geta


	# ---- Install LncDC ---- #

	wget https://github.com/lim74/LncDC/archive/refs/tags/v1.3.5.zip \
		-P /usr/local/src
	unzip -qq /usr/local/src/v1.3.5.zip -d "/usr/local/src/"
	env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin MAMBA_ROOT_PREFIX=/opt/mamba \
		/usr/local/bin/micromamba run -r /opt/mamba -p /opt/envs/lncdc pip install /usr/local/src/LncDC-1.3.5/

	# ---- LncDC DB download ---- #
	mkdir -p /opt/envs/lncdc/share/lncdc_db
	wget --directory-prefix /opt/envs/lncdc/share/lncdc_db \
		https://raw.githubusercontent.com/wyim-pgl/lncdc_db/main/LncDC_plant_db/plant_selected_nostructure_hexamer_table.csv \
		https://raw.githubusercontent.com/wyim-pgl/lncdc_db/main/LncDC_plant_db/plant_selected_nostructure_imputer_SIF_PF.pkl \
		https://raw.githubusercontent.com/wyim-pgl/lncdc_db/main/LncDC_plant_db/plant_selected_nostructure_scaler_SIF_PF.pkl \
		https://raw.githubusercontent.com/wyim-pgl/lncdc_db/main/LncDC_plant_db/plant_selected_nostructure_xgb_model_SIF_PF.pkl


	# ---- Install Pfam Database ---- #
	# Download the Pfam database from the EMBL-EBI FTP site to the /usr/local/src directory
	wget --retry-connrefused \
		--waitretry=1 \
		--read-timeout=20 \
		--timeout=15 \
		--tries=0 \
		--continue \
		-P /usr/local/src \
		ftp://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz

	wget --retry-connrefused \
		--waitretry=1 \
		--read-timeout=20 \
		--timeout=15 \
		--tries=0 \
		--continue \
		-P /usr/local/src \
		ftp://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.dat.gz

	# Decompress the downloaded Pfam database files
	zcat /usr/local/src/Pfam-A.hmm.gz > /usr/local/src/Pfam-A.hmm
	zcat /usr/local/src/Pfam-A.hmm.dat.gz > /usr/local/src/Pfam-A.hmm.dat

	# Press the HMM database for use with HMMER tools (using filter env's hmmpress)
	env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin MAMBA_ROOT_PREFIX=/opt/mamba \
		/usr/local/bin/micromamba run -r /opt/mamba -p /opt/envs/filter hmmpress /usr/local/src/Pfam-A.hmm

	# Remove the compressed Pfam database files
	rm /usr/local/src/Pfam-A.hmm.gz /usr/local/src/Pfam-A.hmm.dat.gz
	cd


	# ---- Install RepeatMasker manually (avoids bioconda post-link interactive configure) ---- #

	REPEAT_PREFIX=/opt/envs/repeat
	export PATH=$REPEAT_PREFIX/bin:$PATH

	# Download and extract RepeatMasker (remove any version pulled in as transitive dep)
	cd /usr/local/src
	wget https://www.repeatmasker.org/RepeatMasker/RepeatMasker-4.1.7-p1.tar.gz
	tar xzf RepeatMasker-4.1.7-p1.tar.gz
	rm -rf $REPEAT_PREFIX/share/RepeatMasker
	mv RepeatMasker $REPEAT_PREFIX/share/RepeatMasker
	rm RepeatMasker-4.1.7-p1.tar.gz

	# Configure RepeatMasker by directly editing RepeatMaskerConfig.pm
	cd $REPEAT_PREFIX/share/RepeatMasker
	chmod 644 *.pm configure
	perl -0777 -i -pe "
		s|('TRF_PRGM'.*?'value' => )''|\$1'$REPEAT_PREFIX/bin/trf'|s;
		s|('HMMER_DIR'.*?'value' => )''|\$1'$REPEAT_PREFIX/bin'|s;
		s|('RMBLAST_DIR'.*?'value' => )''|\$1'$REPEAT_PREFIX/bin'|s;
		s|('LIBDIR'.*?'value' => )''|\$1'$REPEAT_PREFIX/share/RepeatMasker/Libraries'|s;
		s|('DEFAULT_SEARCH_ENGINE'.*?'value' => )''|\$1'rmblast'|s;
	" RepeatMaskerConfig.pm

	# Make RepeatMasker scripts accessible
	ln -sf $REPEAT_PREFIX/share/RepeatMasker/RepeatMasker $REPEAT_PREFIX/bin/RepeatMasker
	ln -sf $REPEAT_PREFIX/share/RepeatMasker/ProcessRepeats $REPEAT_PREFIX/bin/ProcessRepeats
	ln -sf $REPEAT_PREFIX/share/RepeatMasker/rmOutToGFF3.pl $REPEAT_PREFIX/bin/rmOutToGFF3.pl

	# Create Libraries directory
	mkdir -p $REPEAT_PREFIX/share/RepeatMasker/Libraries

	# ---- Install RepeatModeler manually (from GitHub) ---- #
	cd /usr/local/src
	wget https://github.com/Dfam-consortium/RepeatModeler/archive/refs/tags/2.0.5.tar.gz \
		-O RepeatModeler-2.0.5.tar.gz
	tar xzf RepeatModeler-2.0.5.tar.gz
	rm -rf $REPEAT_PREFIX/share/RepeatModeler
	mv RepeatModeler-2.0.5 $REPEAT_PREFIX/share/RepeatModeler
	rm RepeatModeler-2.0.5.tar.gz

	# Configure RepeatModeler by directly editing RepModelConfig.pm
	# (perl ./configure does not reliably accept CLI flags in v2.0.5)
	cd $REPEAT_PREFIX/share/RepeatModeler
	chmod 644 *.pm configure

	perl -0777 -i -pe "
		s|('REPEATMASKER_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/share/RepeatMasker'|s;
		s|('RMBLAST_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
		s|('RECON_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
		s|('RSCOUT_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
		s|('TRF_PRGM'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin/trf'|s;
		s|('CDHIT_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
		s|('LTR_RETRIEVER_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
		s|('GENOMETOOLS_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
		s|('MAFFT_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
		s|('NINJA_DIR'.*?'value' => )'[^']*'|\$1'$REPEAT_PREFIX/bin'|s;
	" RepModelConfig.pm

	# Make RepeatModeler scripts accessible
	ln -sf $REPEAT_PREFIX/share/RepeatModeler/RepeatModeler $REPEAT_PREFIX/bin/RepeatModeler
	ln -sf $REPEAT_PREFIX/share/RepeatModeler/BuildDatabase $REPEAT_PREFIX/bin/BuildDatabase


	# ---- Install Java ---- #
	# Download Java Runtime Environment (JRE) 8u281 from Oracle's website
	wget --retry-connrefused \
		--waitretry=1 \
		--read-timeout=20 \
		--timeout=15 \
		--tries=0 \
		--continue \
		https://javadl.oracle.com/webapps/download/AutoDL?BundleId=244058_89d678f2be164786b292527658ca1605 \
		-O /usr/local/bin/jre-8u281-linux-x64.tar.gz

	# Extract the downloaded tar.gz file to /usr/local/bin
	tar zxf /usr/local/bin/jre-8u281-linux-x64.tar.gz \
		-C /usr/local/bin/

	# Remove the downloaded tar.gz file
	rm /usr/local/bin/jre-8u281-linux-x64.tar.gz


	# ---- Install EvidenceModeler (EVM) ---- #
	# Download EVM version 2.1.0 from GitHub
	wget --retry-connrefused \
		--waitretry=1 \
		--read-timeout=20 \
		--timeout=15 \
		--tries=0 \
		--continue \
		https://github.com/EVidenceModeler/EVidenceModeler/releases/download/EVidenceModeler-v2.1.0/EVidenceModeler-v2.1.0.tar.gz \
		-O /usr/local/src/v2.1.0.tar.gz

	# Extract the downloaded tar.gz file to /usr/local/bin
	tar zxf /usr/local/src/v2.1.0.tar.gz -C /usr/local/bin

	# Set the EVM_HOME environment variable
	export EVM_HOME=/usr/local/bin/EVidenceModeler-v2.1.0/

	# Navigate to the EVM_HOME directory and compile EVM with 2 threads
	cd $EVM_HOME
	make -j 2

	# Navigate back to the previous directory
	cd -

	# Remove the downloaded tar.gz file
	rm /usr/local/src/v2.1.0.tar.gz


	# ---- Install EviGene ---- #
	# Download EviGene package
	wget --retry-connrefused \
		--waitretry=1 \
		--read-timeout=20 \
		--timeout=15 \
		--tries=0 \
		--continue \
		http://arthropods.eugenes.org/EvidentialGene/other/evigene_old/evigene.tar \
		-O /usr/local/bin/evigene.tar

	# Create a directory to extract EviGene
	mkdir /usr/local/bin/evigene

	# Extract EviGene package into the created directory
	tar -xf /usr/local/bin/evigene.tar \
		-C /usr/local/bin/evigene


	# ---- PASA patch: use CSI index so chromosomes >512Mb are supported ---- #
	# BAI is 32-bit (max ~512Mb); samtools index needs -c for large genomes.
	for f in $(find /opt -name process_minimap2_alignments.pl 2>/dev/null); do
		sed -i 's/samtools index \$output/samtools index -c \$output/g' "$f"
	done

	# ---- GETA shebang fix: scripts use #!/opt/miniconda3/bin/perl which ---- #
	# this build no longer provides. Rewrite to env-relative perl.
	if [ -d /usr/local/bin/geta ]; then
		grep -rIl '^#!/opt/miniconda3/bin/perl' /usr/local/bin/geta 2>/dev/null | \
			xargs -r sed -i '1c#!/usr/bin/env perl'
	fi

	# ---- TransDecoder symlink fix: package moved scripts to util/ ---- #
	# Conda's TransDecoder feedstock now installs binaries under
	# opt/transdecoder/util/, but the env's bin/ symlinks still point at the
	# old opt/transdecoder/ location, producing broken links.
	for env_bin in /opt/envs/annotation/bin /opt/envs/genepred/bin; do
		[ -d "$env_bin" ] || continue
		for link in "$env_bin"/TransDecoder.*; do
			[ -L "$link" ] || continue
			[ -e "$link" ] && continue
			base=$(basename "$link")
			if [ -e "$env_bin/../opt/transdecoder/util/$base" ]; then
				ln -sf "../opt/transdecoder/util/$base" "$link"
			fi
		done
	done

	# ---- Cleanup ---- #
	env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin MAMBA_ROOT_PREFIX=/opt/mamba \
		/usr/local/bin/micromamba clean --all -f --yes
	rm -rf /tmp/envs/

	# ---- Pre-generate the micromamba shell hook ----
	# Generate the bash hook ONCE at build time and source it at runtime (see
	# %environment) instead of forking `micromamba shell hook` on every container
	# shell startup. That per-startup fork has a hardcoded 5s timeout that gets
	# killed under heavy cluster I/O (crashing jobs at `micromamba activate`).
	mkdir -p /opt/mamba/etc
	env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin MAMBA_ROOT_PREFIX=/opt/mamba \
		/usr/local/bin/micromamba shell hook --shell bash --root-prefix /opt/mamba \
		> /opt/mamba/etc/mamba_hook.sh 2>/dev/null
	# Drop the interactive completion section (the trailing top-level
	# `if [ -n "${ZSH_VERSION...}" ]` block through EOF, covering both zsh and bash
	# completions). It is useless for batch container execution and uses zsh /
	# bash-array syntax that Apptainer's POSIX environment-file parser rejects with
	# "parameter expansion requires a literal" when %environment is sourced.
	sed -i '/^if \[ -n "${ZSH_VERSION:+x}" \]; then$/,$d' /opt/mamba/etc/mamba_hook.sh || true
	# Fail the build rather than ship an image whose hook is empty or truncated:
	# an unusable hook would leave `micromamba` undefined in every container. The
	# function is emitted indented inside a `case`, so do not anchor the pattern.
	if [ ! -s /opt/mamba/etc/mamba_hook.sh ] \
		|| ! grep -q 'micromamba()' /opt/mamba/etc/mamba_hook.sh \
		|| ! grep -q '__mamba_wrap' /opt/mamba/etc/mamba_hook.sh; then
		echo "FATAL: /opt/mamba/etc/mamba_hook.sh is empty or does not define micromamba()" >&2
		exit 1
	fi

%startscript


%environment

	# Set the Locale to 'C' to ensure consistent behavior across different systems
	export LC_ALL=C

	# Micromamba root prefix (envs are at /opt/envs/, symlinked from /opt/mamba/envs/)
	export MAMBA_ROOT_PREFIX=/opt/mamba
	export PATH=/usr/local/bin:$PATH

	# Add Java to PATH (required by EVM)
	export PATH=/usr/local/bin/jre1.8.0_281/bin:$PATH

	# Add the path for GETA executables to the PATH environment variable
	export PATH=/usr/local/bin/geta/bin:$PATH

	# Add the path for PsiCLASS executables to the PATH environment variable
	export PATH=/usr/local/src/PsiCLASS:$PATH

	# Add the path for EVidenceModeler executables to the PATH environment variable
	export PATH=/usr/local/bin/EVidenceModeler-v2.1.0/:$PATH

	# Add the path for EvmUtils, which is part of EVidenceModeler, to the PATH environment variable
	export PATH=/usr/local/bin/EVidenceModeler-v2.1.0/EvmUtils/:$PATH

	# Set the path for Evigene executables, enabling direct execution without specifying the full path
	export evigene=/usr/local/bin/evigene

	# Set the Wise2 configuration directory (required by genewise)
	export WISECONFIGDIR=/opt/envs/genepred/share/wise2/wisecfg

	# ProtHint spaln bundle (2026-08-10 pilot): species parameter tables + binaries on PATH
	export ALN_TAB=/opt/ProtHint/dependencies/spaln_table
	export PATH=/opt/ProtHint/dependencies:$PATH

	# Micromamba shell hook (so `micromamba activate` works in shell commands).
	# Source the hook pre-generated in %post instead of forking `micromamba shell
	# hook` on every startup: that fork has a 5s timeout that kills jobs under heavy
	# cluster I/O and emits a harmless zsh-completion parse error. Fall back to the
	# live eval only if the pre-generated hook is missing (older images). Test -s,
	# not -r: an empty hook is readable, and would silently skip the fallback.
	export MAMBA_EXE='/usr/local/bin/micromamba'
	if [ -s /opt/mamba/etc/mamba_hook.sh ]; then
		. /opt/mamba/etc/mamba_hook.sh
	else
		eval "$($MAMBA_EXE shell hook --shell bash --root-prefix $MAMBA_ROOT_PREFIX 2>/dev/null)" || alias micromamba="$MAMBA_EXE"
	fi

%labels
	Author Johnny Lomas (jlomas@nevada.unr.edu)
	Version v2.0.0

%help


